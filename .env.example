# Jira
JIRA_URL=https://yoursite.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-token-here
JIRA_PROJECT_KEY=SCRUM

# LLM (any OpenAI-compatible endpoint)
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://your-llm-endpoint.example.com/v1
LLM_MODEL=your-model-name

# GitHub (will be filled on Day 3)
GITHUB_TOKEN=your-github-pat-here
GITHUB_REPO=your-username/multi-agent-test-automation

# App URL under test
BASE_URL=https://www.saucedemo.com

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION CREDENTIALS  (never commit real values; set these as GitHub
# Secrets in CI). Feature files refer to a ROLE; the `credentials` fixture in
# tests/step_defs/conftest.py resolves the role from these variables.
#
# Shared password (used when no per-role override is set):
APP_PASSWORD=

# One entry per role your tests log in as:
# Preferred: ONE variable, works for ANY app. Format: role=username,role=username
APP_USERS=standard=standard_user,locked_out=locked_out_user

# Still supported per-role (used when a role is absent from APP_USERS):
APP_USER_STANDARD=
APP_USER_LOCKED_OUT=
APP_USER_PROBLEM=
APP_USER_PERFORMANCE_GLITCH=
APP_USER_ERROR=
APP_USER_VISUAL=

# Optional per-role password override, if roles do NOT share one password:
# APP_PASSWORD_STANDARD=
