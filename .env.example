# Jira
JIRA_URL=https://yoursite.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-token-here
JIRA_PROJECT_KEY=SCRUM

# LLM (any OpenAI-compatible endpoint)
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://your-llm-endpoint.example.com/v1
LLM_MODEL=your-model-name

# GitHub (will be filled on Day 3)
GITHUB_TOKEN=your-github-pat-here
GITHUB_REPO=your-username/multi-agent-test-automation

# App URL under test
BASE_URL=url-of-your-app-under-test

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION CREDENTIALS  (never commit real values; set these as GitHub
# Secrets in CI). Feature files refer to a ROLE; the `credentials` fixture in
# tests/step_defs/conftest.py resolves the role from these variables.
#
# App under test: OrangeHRM demo (https://opensource-demo.orangehrmlive.com).
# The demo prints its own credentials on the login screen (Admin / admin123),
# but they still live here rather than in code, so pointing at a client app
# with real credentials needs no code change.
#
# One variable per login role. These names must match the repo's GitHub Actions
# secrets exactly - .github/workflows/agent4_runner.yml forwards them by name.

APP_PASSWORD=password-for-the-registered-account
APP_USER_REGISTERED=your-registered-email@example.com
# ── OPTIONAL: browser tools (inventory crawl, staleness check, verify) ──────
# These need ONE login to get past the login wall; they do not care about
# roles. By default they use the single APP_USER_<ROLE> above, so you normally
# leave these UNSET.
#
# Set them only if you have SEVERAL roles and must say which one to crawl as -
# otherwise the tools refuse to guess and report that they need a hint.
# INVENTORY_USER=
# INVENTORY_PASS=          # falls back to APP_PASSWORD

# Optional per-role password override, if roles do NOT share one password:
# APP_PASSWORD_REGISTERED=
